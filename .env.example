# ─── Django ───────────────────────────────────────────────
DJANGO_SECRET_KEY=django-insecure-replace-me-with-a-real-secret-key
DJANGO_DEBUG=1

# ─── PostgreSQL ───────────────────────────────────────────
POSTGRES_DB=dogo
POSTGRES_USER=dogo
POSTGRES_PASSWORD=dogo_pass_123
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ─── Redis / Channels ─────────────────────────────────────
# memory — для локалки, redis — для прода
CHANNEL_BACKEND=redis
REDIS_URL=redis://redis:6379/0

# ─── Chatflow (WhatsApp OTP) ──────────────────────────────
CHATFLOW_BASE_URL=https://app.chatflow.kz
CHATFLOW_TOKEN=your_chatflow_token_here
CHATFLOW_INSTANCE_ID=your_instance_id_here
OTP_TTL_SECONDS=300

# ─── Finik (Платежи) ──────────────────────────────────────
FINIK_CURRENCY=KGS
FINIK_CALLBACK_URL=https://dordoi-go.tech/api/payments/finik/callback/
