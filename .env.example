# Django production
DJANGO_DEBUG=0
ENABLE_DEBUG_OTP_ENDPOINT=0
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_ALLOWED_HOSTS=api.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://api.example.com
DJANGO_USE_SQLITE=0
DJANGO_SECURE_SSL_REDIRECT=1
DJANGO_SESSION_COOKIE_SECURE=1
DJANGO_CSRF_COOKIE_SECURE=1
# Enable HSTS only after HTTPS is verified and stable.
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=0
DJANGO_SECURE_HSTS_PRELOAD=0

# PostgreSQL. docker-compose.prod.yml forces POSTGRES_HOST=postgres.
DATABASE_URL=
DB_CONN_MAX_AGE=60
POSTGRES_DB=safa
POSTGRES_USER=safa
POSTGRES_PASSWORD=replace-with-a-strong-database-password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Django Channels / Redis. Production must use the shared Redis layer.
CHANNEL_BACKEND=redis
REDIS_URL=redis://redis:6379/0

# WhatsApp OTP via Chatflow
CHATFLOW_BASE_URL=https://app.chatflow.kz
CHATFLOW_TOKEN=
CHATFLOW_FLOW_ID=
# Legacy lk.chatflow.kz accounts only:
CHATFLOW_INSTANCE_ID=
CHATFLOW_TIMEOUT_SECONDS=15
OTP_TTL_SECONDS=300
OTP_LENGTH=4
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
# Keep both empty in production.
DEMO_OTP_CODE=
STATIC_OTP=

# Geocoding and map editor
YANDEX_API_KEY=
GOOGLE_MAPS_BROWSER_API_KEY=
GOOGLE_MAPS_API_KEY=
OSRM_URL=https://router.project-osrm.org

# Firebase Cloud Messaging. JSON files are mounted read-only by Compose.
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_FILE=
FCM_ANDROID_PROJECT_ID=safa-app-87b24
FCM_ANDROID_SERVICE_ACCOUNT_FILE=/run/secrets/firebase-android.json
FCM_IOS_PROJECT_ID=dogoapp-7b7a2
FCM_IOS_SERVICE_ACCOUNT_FILE=/run/secrets/firebase-ios.json

# Order matching and accounting
PLATFORM_COMMISSION_PCT=0.10
SPECIALIST_OFFER_RADIUS_M=2500
SPECIALIST_OFFER_MAX_CANDIDATES=20
SPECIALIST_POSITION_STALE_MINUTES=30

# Finik
FINIK_CURRENCY=KGS
FINIK_ACCOUNT_ID=
FINIK_API_KEY=
FINIK_BETA=0
FINIK_TIMEOUT_SECONDS=15
FINIK_GRAPHQL_URL=
# Must remain false in production so real shipment fares are charged.
FINIK_TEST_AMOUNT=false
FINIK_CALLBACK_URL=https://api.example.com/api/payments/finik/callback/
