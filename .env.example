DJANGO_DEBUG=0
ENABLE_DEBUG_OTP_ENDPOINT=0
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_USE_SQLITE=0
DJANGO_SECURE_SSL_REDIRECT=0
DJANGO_SESSION_COOKIE_SECURE=0
DJANGO_CSRF_COOKIE_SECURE=0

DATABASE_URL=
DB_CONN_MAX_AGE=60
POSTGRES_DB=dogo
POSTGRES_USER=dogo
POSTGRES_PASSWORD=dogo_pass_123
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

CHANNEL_BACKEND=memory
REDIS_URL=redis://127.0.0.1:6379/0

CHATFLOW_BASE_URL=https://app.chatflow.kz
CHATFLOW_TOKEN=
# Flow ID from the n8n integration configured in Chatflow.
CHATFLOW_FLOW_ID=
# Legacy only: use this instead of CHATFLOW_FLOW_ID with lk.chatflow.kz.
CHATFLOW_INSTANCE_ID=
CHATFLOW_TIMEOUT_SECONDS=15
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
STATIC_OTP=
GOOGLE_MAPS_BROWSER_API_KEY=

YANDEX_API_KEY=
# Legacy/single-project fallback. It is reused only when its project ID matches
# the platform project below.
FCM_PROJECT_ID=dogoapp-7b7a2
FCM_SERVICE_ACCOUNT_FILE=

# Current Flutter configuration uses different Firebase projects per platform.
# Android tokens are issued by safa-app-87b24.
FCM_ANDROID_PROJECT_ID=safa-app-87b24
FCM_ANDROID_SERVICE_ACCOUNT_FILE=
# iOS tokens are issued by dogoapp-7b7a2.
FCM_IOS_PROJECT_ID=dogoapp-7b7a2
FCM_IOS_SERVICE_ACCOUNT_FILE=

PLATFORM_COMMISSION_PCT=0.10

FINIK_CURRENCY=KGS
# Corporate account ID issued by Finik (not the Flutter SDK API key).
FINIK_ACCOUNT_ID=
# Same API client key passed to the Flutter Finik SDK. Backend uses it to
# verify transactionId against Finik before marking a shipment paid.
FINIK_API_KEY=
FINIK_BETA=1
FINIK_TIMEOUT_SECONDS=15
FINIK_GRAPHQL_URL=
# Set to a positive integer (for example 1) to charge that amount for every
# Finik payment. Use false in production to charge the real shipment fare.
FINIK_TEST_AMOUNT=false
# Optional when the backend's public request URL is already correct.
FINIK_CALLBACK_URL=
